{
  "name": "docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev -p 3004",
    "start": "next start",
    "preview": "pnpm cf:build && opennextjs-cloudflare preview",
    "deploy": "pnpm cf:build && opennextjs-cloudflare deploy",
    "upload": "pnpm cf:build && opennextjs-cloudflare upload",
    "cf:build": "fumadocs-mdx && CF_BUILD=1 opennextjs-cloudflare build",
    "types:check": "fumadocs-mdx && tsc --noEmit",
    "postinstall": "fumadocs-mdx",
    "lint": "biome check",
    "format": "biome format --write"
  },
  "dependencies": {
    "beautiful-mermaid": "^1.1.3",
    "fumadocs-core": "16.12.1",
    "fumadocs-mdx": "15.2.0",
    "fumadocs-ui": "16.12.1",
    "lucide-react": "^0.552.0",
    "next": "16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@opennextjs/cloudflare": "^1.20.17",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "wrangler": "^4.165.0"
  }
}
